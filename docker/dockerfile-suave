# syntax=docker/dockerfile:1
ARG BASE_IMAGE="ghcr.io/kas-lab/kasm-jammy:latest"
FROM $BASE_IMAGE

USER root

### Envrionment config
ENV DEBIAN_FRONTEND=noninteractive

###Add Sudo
RUN apt update && apt install -y \
    sudo \
    tzdata\
    vim \
    wget \
    curl \
    lsb-release \
    gnupg \
    wmctrl \
    git \
    software-properties-common \
    libgl1-mesa-glx \
    libgl1-mesa-dri \
    libglx-mesa0 \
    bash-completion \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Set the locale
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

RUN sudo apt-get update && sudo apt-get install -y \
    openjdk-25-jdk \
    && sudo rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-25-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

### Install ROS2
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg
RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null

RUN apt update && apt install -y \
  ros-humble-ros-base \
  python3-rosdep \
  python3-vcstool \
  python3-colcon-common-extensions  \
  && rm -rf /var/lib/apt/lists/

RUN rosdep init

### Install Gazebo
RUN curl https://packages.osrfoundation.org/gazebo.gpg --output /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/gazebo-stable.list > /dev/null

RUN bash -c 'curl https://raw.githubusercontent.com/osrf/osrf-rosdep/master/gz/00-gazebo.list --output /etc/ros/rosdep/sources.list.d/00-gazebo.list'
ENV GZ_VERSION=harmonic

RUN apt update && apt install -y \
    gz-harmonic \
    ros-humble-ros-gzharmonic \
	&& rm -rf /var/lib/apt/lists/

###Add the USER env var
RUN echo 'kasm-user ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers
ENV HOME=/home/kasm-user
USER kasm-user
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR $HOME

# Git commit SHAs — passed in by build_docker_images.sh from docker/versions.env
ARG ARDUSUB_COMMIT=571e8c7bd3793fce1bc5184a2f6586feb8a616e5
ARG ARDUPILOT_GAZEBO_COMMIT=082a0fe231f6e63bc8d1598f1cba461d9e2ea7f5

# Install ArduSub. Only the pinned commit is fetched: waf needs .git for
# `git rev-parse HEAD` and submodule checks, but not the project history.
RUN mkdir $HOME/ardupilot && cd $HOME/ardupilot \
    && git init -q \
    && git remote add origin https://github.com/ArduPilot/ardupilot.git \
    && git fetch -q --depth 1 origin $ARDUSUB_COMMIT \
    && git checkout -q FETCH_HEAD \
    && git submodule update --init --recursive
WORKDIR $HOME/ardupilot

# DO_AP_STM_ENV=0 skips the STM32 firmware toolchain; SITL builds with the host g++.
RUN USER=kasm-user DO_AP_STM_ENV=0 Tools/environment_install/install-prereqs-ubuntu.sh -y \
    && sudo rm -rf /var/lib/apt/lists/* $HOME/.cache/pip

# Copied here rather than earlier so a pin change keeps the clone and prereqs
# layers; it must still precede the waf build, which needs the pinned empy.
COPY --chown=kasm-user:kasm-user requirements.txt $HOME/requirements.txt
RUN pip3 install --no-cache-dir -r $HOME/requirements.txt

ENV PATH=$PATH:$HOME/ardupilot/Tools/autotest
ENV PATH=/usr/lib/ccache:$PATH

RUN ["/bin/bash","-c","cd $HOME/ardupilot && ./waf configure && make sub && ccache -C"]

# install ardupilot gazebo plugin
RUN sudo apt update && sudo apt install -y \
    rapidjson-dev \
    libgz-sim8-dev \
    libopencv-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-libav \
    gstreamer1.0-gl \
    && sudo rm -rf /var/lib/apt/lists/*

WORKDIR $HOME
RUN git clone https://github.com/ArduPilot/ardupilot_gazebo && \
    cd ardupilot_gazebo && \
    git checkout $ARDUPILOT_GAZEBO_COMMIT && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=RelWithDebInfo && \
    make -j4

ENV GZ_SIM_SYSTEM_PLUGIN_PATH=$HOME/ardupilot_gazebo/build
ENV GZ_SIM_RESOURCE_PATH=$HOME/ardupilot_gazebo/models:$HOME/ardupilot_gazebo/worlds

# Copy suave files
RUN mkdir -p $HOME/suave_ws/src
COPY --chown=kasm-user:kasm-user suave.repos $HOME/suave_ws/suave.repos
WORKDIR $HOME/suave_ws/
RUN vcs import src < suave.repos --recursive

# Install suave deps from the package manifests alone, so editing sources
# does not rerun rosdep or geographiclib.
RUN rm -rf $HOME/suave_ws/src/suave/
COPY --parents --chown=kasm-user:kasm-user suave*/package.xml suave_managing/*/package.xml $HOME/suave_ws/src/suave/

WORKDIR $HOME/suave_ws
RUN ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash \
    && sudo apt update \
    && rosdep update \
    && rosdep install --from-paths src --ignore-src -r -y \
    && sudo rm -rf /var/lib/apt/lists/* /root/.cache"]

RUN ["/bin/bash", "-c", "sudo ./src/mavros/mavros/scripts/install_geographiclib_datasets.sh"]

COPY --chown=kasm-user:kasm-user suave/ $HOME/suave_ws/src/suave/suave/
COPY --chown=kasm-user:kasm-user suave_bringup/ $HOME/suave_ws/src/suave/suave_bringup/
COPY --chown=kasm-user:kasm-user suave_managing/ $HOME/suave_ws/src/suave/suave_managing/
COPY --chown=kasm-user:kasm-user suave_metrics/ $HOME/suave_ws/src/suave/suave_metrics/
COPY --chown=kasm-user:kasm-user suave_missions/ $HOME/suave_ws/src/suave/suave_missions/
COPY --chown=kasm-user:kasm-user suave_monitor/ $HOME/suave_ws/src/suave/suave_monitor/
COPY --chown=kasm-user:kasm-user suave_requirements/ $HOME/suave_ws/src/suave/suave_requirements/
COPY --chown=kasm-user:kasm-user suave_msgs/ $HOME/suave_ws/src/suave/suave_msgs/
COPY --chown=kasm-user:kasm-user suave_runner/ $HOME/suave_ws/src/suave/suave_runner/
COPY --chown=kasm-user:kasm-user suave_tools/ $HOME/suave_ws/src/suave/suave_tools/
COPY --chown=kasm-user:kasm-user suave_base/ $HOME/suave_ws/src/suave/suave_base/
COPY --chown=kasm-user:kasm-user suave_cli/ $HOME/suave_ws/src/suave/suave_cli/
COPY --chown=kasm-user:kasm-user env.sh $HOME/suave_ws/src/suave/env.sh

# Build suave
RUN ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash \
    && colcon build --symlink-install \
    && ccache -C \
    && echo 'source ~/suave_ws/install/setup.bash' >> ~/.bashrc"]


RUN sudo apt autoremove -y && sudo rm -rf /var/lib/apt/lists/

COPY --chown=kasm-user:kasm-user runner/ $HOME/suave_ws/src/suave/runner/

# User-level pip scripts (mavproxy.py for sim_vehicle.py) must resolve in
# non-login shells too; appended so it never shadows system tools.
ENV PATH=${PATH}:${HOME}/.local/bin

# suave CLI: on PATH in every shell, including docker exec
ENV SUAVE_ROOT=/home/kasm-user/suave_ws/src/suave
ENV SUAVE_CLI_CONTEXT=container
ENV PATH=${SUAVE_ROOT}/suave_cli/bin:${PATH}
WORKDIR $HOME/suave_ws/src/suave/runner/

CMD ["--tail-log"]
