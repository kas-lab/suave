<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>suave_bringup</name>
  <version>0.0.0</version>
  <description>Top-level launch composition for SUAVE missions and managers</description>
  <maintainer email="g.rezendesilva@tudelft.nl">Gustavo Rezende</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>suave_base</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>suave</exec_depend>
  <exec_depend>suave_bt</exec_depend>
  <exec_depend>suave_metacontrol</exec_depend>
  <exec_depend>suave_metrics</exec_depend>
  <exec_depend>suave_missions</exec_depend>
  <exec_depend>suave_none</exec_depend>
  <exec_depend>suave_random</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
